{
  "name": "@tod/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "setup": "tsx --env-file=.env src/setup.ts",
    "typecheck": "tsc --noEmit",
    "groups:setup": "tsx --env-file=.env src/groups-setup.ts",
    "groups:backfill": "tsx --env-file=.env src/groups-backfill.ts",
    "worker": "tsx --env-file=.env src/groups-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "argon2": "^0.41.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0",
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
