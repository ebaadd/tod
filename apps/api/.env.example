RUN_LOCAL=true
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://tod:local_tod_password@localhost:5433/tod
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=tod-submissions-local
COOKIE_SECURE=false
RETENTION_DAYS=90
SESSION_DAYS=30

# local  = run the ONNX model in-process (no network, no cost)
# bedrock = call Amazon Bedrock (needs outbound access from the function)
EMBEDDING_PROVIDER=local
GROUP_SIMILARITY_THRESHOLD=0.62
MODEL_CACHE_DIR=.cache/models

# Set in AWS only. Locally there is no CloudFront in front of the API.
# EDGE_SECRET=
# PG_CA_BUNDLE=
# PG_POOL_MAX=2
