# Copy to terraform.tfvars and edit.

region      = "ap-south-1"
alert_email = "you@example.com"

# Alerts only; it does not stop spending. The hard cap is the setting below.
monthly_budget_usd = 5

# The real brake. Requests past this are throttled rather than billed.
api_reserved_concurrency = 50

# deploy.sh sets image_tag and web_origin. Do not set them by hand.
